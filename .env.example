# Generate a unique value with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-random-value-at-least-50-characters-long
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

DB_NAME=apirest
DB_USER=api_user
DB_PASSWORD=replace-with-a-unique-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
API_PORT=3213

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:3213
